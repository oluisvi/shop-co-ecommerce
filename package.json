{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/*.test.ts src/data/*.test.ts",
    "api:dev": "npm --prefix server run dev",
    "api:build": "npm --prefix server run build",
    "api:test": "npm --prefix server test",
    "api:typecheck": "npm --prefix server run typecheck",
    "api:lint": "npm --prefix server run lint",
    "test:all": "npm test && npm run api:test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
